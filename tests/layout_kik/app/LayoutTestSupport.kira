import Foundation
import KiraLayout

// Tree builders the cases share. Names use the lyk / Lyk prefix.

function lykNoInsets() -> EdgeInsets {
    return EdgeInsets(top: 0.0, trailing: 0.0, bottom: 0.0, leading: 0.0)
}

// A node with its descriptor already flattened into it. `layoutNodeFlattenDescriptor`
// writes THROUGH the node it is given, so the node has to be a variable first.
function lykNode(firstChild: Int, childCount: Int, desc: LayoutDescriptor) -> LayoutNode {
    var node = LayoutNode(
        firstChild: firstChild,
        childCount: childCount
    )
    layoutNodeFlattenDescriptor(node, desc)
    return node
}

function lykLeafDescriptor(width: SizeMode, height: SizeMode) -> LayoutDescriptor {
    return LayoutDescriptor(
        width: width,
        height: height,
        arrange: ArrangeMode.Fill,
        axis: Axis.Vertical,
        alignment: CrossAlignment.Stretch,
        overlayAlignment: Alignment.Center,
        padding: lykNoInsets(),
        margin: lykNoInsets()
    )
}

function lykFixedLeaf(width: Float, height: Float) -> LayoutNode {
    return lykNode(
        firstChild: 0,
        childCount: 0,
        desc: lykLeafDescriptor(width: SizeMode.Fixed(width), height: SizeMode.Fixed(height))
    )
}

// The leaf every "spacer" case is about: it asks for whatever the parent has.
function lykFillLeaf() -> LayoutNode {
    return lykNode(
        firstChild: 0,
        childCount: 0,
        desc: lykLeafDescriptor(width: SizeMode.Fill, height: SizeMode.Fill)
    )
}

function lykStack(
    width: SizeMode,
    height: SizeMode,
    axis: Axis,
    alignment: CrossAlignment,
    spacing: Float,
    padding: EdgeInsets,
    firstChild: Int,
    childCount: Int,
) -> LayoutNode {
    return lykNode(
        firstChild: firstChild,
        childCount: childCount,
        desc: LayoutDescriptor(
            width: width,
            height: height,
            arrange: ArrangeMode.Stack,
            axis: axis,
            spacing: spacing,
            alignment: alignment,
            overlayAlignment: Alignment.Center,
            padding: padding,
            margin: lykNoInsets()
        )
    )
}

function lykOverlay(width: SizeMode, height: SizeMode, firstChild: Int, childCount: Int) -> LayoutNode {
    return lykNode(
        firstChild: firstChild,
        childCount: childCount,
        desc: LayoutDescriptor(
            width: width,
            height: height,
            arrange: ArrangeMode.Overlay,
            axis: Axis.Vertical,
            alignment: CrossAlignment.Center,
            overlayAlignment: Alignment.Center,
            padding: lykNoInsets(),
            margin: lykNoInsets()
        )
    )
}

// Both passes over a tree, the way a host runs them.
function lykLayout(tree: LayoutTree, available: Size) -> LayoutTree {
    var laid = tree
    let engine = LayoutEngine()
    engine.measure(tree: laid, index: 0, available: available)
    engine.place(tree: laid, index: 0, origin: Point(x: 0.0, y: 0.0))
    return laid
}

function lykFramesEqual(a: borrow Rect, b: borrow Rect) -> Bool {
    return a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
}

// --- Trees under test --------------------------------------------------------

// A row that hugs its height, holding a label, a spacer and a trailing control —
// the shape every inspector and list row in a chrome UI has.
function lykHugRow() -> LayoutTree {
    var tree = LayoutTree(nodes: [
        lykStack(
            width: SizeMode.Fill,
            height: SizeMode.Hug,
            axis: Axis.Horizontal,
            alignment: CrossAlignment.Center,
            spacing: 0.0,
            padding: lykNoInsets(),
            firstChild: 1,
            childCount: 3
        ),
        lykFixedLeaf(width: 60.0, height: 20.0),
        lykFillLeaf(),
        lykFixedLeaf(width: 40.0, height: 20.0)
    ])
    return lykLayout(tree: move tree, available: Size(width: 300.0, height: 800.0))
}

// Three fixed children in a row with room to spare — the window controls, the
// quick-link pills, any toolbar. Each one must start after the one before it
// ends, or they are drawn on top of each other.
function lykFixedTrio(available: Float) -> LayoutTree {
    var tree = LayoutTree(nodes: [
        lykStack(
            width: SizeMode.Fill,
            height: SizeMode.Hug,
            axis: Axis.Horizontal,
            alignment: CrossAlignment.Center,
            spacing: 8.0,
            padding: lykNoInsets(),
            firstChild: 1,
            childCount: 3
        ),
        lykFixedLeaf(width: 108.0, height: 48.0),
        lykFixedLeaf(width: 108.0, height: 48.0),
        lykFixedLeaf(width: 108.0, height: 48.0)
    ])
    return lykLayout(tree: move tree, available: Size(width: available, height: 200.0))
}

// The right edge of child `index`, which is where the next one may begin.
function lykFrameRight(tree: borrow LayoutTree, index: Int) -> Float {
    let frame = layoutFrame(tree, index)
    return frame.x + frame.width
}

// The same shape turned a quarter: a column that hugs its width.
function lykHugColumn() -> LayoutTree {
    var tree = LayoutTree(nodes: [
        lykStack(
            width: SizeMode.Hug,
            height: SizeMode.Fill,
            axis: Axis.Vertical,
            alignment: CrossAlignment.Start,
            spacing: 0.0,
            padding: lykNoInsets(),
            firstChild: 1,
            childCount: 3
        ),
        lykFixedLeaf(width: 60.0, height: 20.0),
        lykFillLeaf(),
        lykFixedLeaf(width: 30.0, height: 24.0)
    ])
    return lykLayout(tree: move tree, available: Size(width: 500.0, height: 800.0))
}

// An overlay that hugs, holding a fixed badge and a filling wash — the selection
// band behind a row.
function lykHugOverlay() -> LayoutTree {
    var tree = LayoutTree(nodes: [
        lykOverlay(width: SizeMode.Hug, height: SizeMode.Hug, firstChild: 1, childCount: 2),
        lykFixedLeaf(width: 40.0, height: 20.0),
        lykFillLeaf()
    ])
    return lykLayout(tree: move tree, available: Size(width: 640.0, height: 480.0))
}

// A window split: a fixed sidebar beside filling content, inside a padded root.
function lykSplit() -> LayoutTree {
    var tree = LayoutTree(nodes: [
        lykStack(
            width: SizeMode.Fixed(1280.0),
            height: SizeMode.Fixed(720.0),
            axis: Axis.Horizontal,
            alignment: CrossAlignment.Stretch,
            spacing: 40.0,
            padding: EdgeInsets(top: 40.0, trailing: 40.0, bottom: 40.0, leading: 40.0),
            firstChild: 1,
            childCount: 2
        ),
        lykNode(
            firstChild: 0,
            childCount: 0,
            desc: lykLeafDescriptor(width: SizeMode.Fixed(250.0), height: SizeMode.Fill)
        ),
        lykFillLeaf()
    ])
    return lykLayout(tree: move tree, available: Size(width: 1280.0, height: 720.0))
}

// A nested tree with no flexible node in it: every subtree can be reused when
// nothing changed.
function lykRetainedTree() -> LayoutTree {
    return LayoutTree(nodes: [
        lykStack(width: SizeMode.Fixed(200.0), height: SizeMode.Fixed(200.0), axis: Axis.Vertical, alignment: CrossAlignment.Start, spacing: 0.0, padding: lykNoInsets(), firstChild: 1, childCount: 2),
        lykStack(width: SizeMode.Fixed(60.0), height: SizeMode.Fixed(40.0), axis: Axis.Vertical, alignment: CrossAlignment.Start, spacing: 0.0, padding: lykNoInsets(), firstChild: 3, childCount: 1),
        lykStack(width: SizeMode.Fixed(60.0), height: SizeMode.Fixed(40.0), axis: Axis.Vertical, alignment: CrossAlignment.Start, spacing: 0.0, padding: lykNoInsets(), firstChild: 4, childCount: 1),
        lykFixedLeaf(width: 30.0, height: 20.0),
        lykFixedLeaf(width: 30.0, height: 20.0)
    ])
}

// A baseline row: a big run of text, a small one, a glyph beside them, and a
// spacer between — the shape a window's toolbar and every form row has.
//
// Baselines are the fourth argument to the leaf: the big run sits 18 down from
// its own top, the small one 12, and the glyph asks to sit 14 down. The spacer
// has none, and asks for the whole row's height.
function lykBaselineLeaf(width: Float, height: Float, baseline: Float) -> LayoutNode {
    return lykNode(
        firstChild: 0,
        childCount: 0,
        desc: LayoutDescriptor(
            width: SizeMode.Fixed(width),
            height: SizeMode.Fixed(height),
            arrange: ArrangeMode.Fill,
            axis: Axis.Vertical,
            alignment: CrossAlignment.Stretch,
            overlayAlignment: Alignment.Center,
            baseline: baseline,
            padding: lykNoInsets(),
            margin: lykNoInsets()
        )
    )
}

function lykBaselineRow() -> LayoutTree {
    var tree = LayoutTree(nodes: [
        lykStack(
            width: SizeMode.Fill,
            height: SizeMode.Hug,
            axis: Axis.Horizontal,
            alignment: CrossAlignment.Baseline,
            spacing: 0.0,
            padding: lykNoInsets(),
            firstChild: 1,
            childCount: 4
        ),
        lykBaselineLeaf(width: 60.0, height: 24.0, baseline: 18.0),
        lykBaselineLeaf(width: 40.0, height: 16.0, baseline: 12.0),
        lykBaselineLeaf(width: 20.0, height: 20.0, baseline: 14.0),
        lykFillLeaf()
    ])
    return lykLayout(tree: move tree, available: Size(width: 300.0, height: 800.0))
}

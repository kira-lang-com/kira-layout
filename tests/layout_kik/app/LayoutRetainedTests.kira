import Foundation
import KiraLayout

// Retained-layout cases: a pass over an unchanged tree recomputes nothing, and a
// pass after one changed leaf recomputes that leaf's ancestors while every other
// subtree keeps the geometry it already had.

struct LykRetainedRun {
    let measureComputes: Number
    let placeComputes: Number
    let measureSkips: Number
    let placeSkips: Number
    let changedWidth: Number
    let siblingReused: Bool
}

function retainedRun(changeLeaf: Bool) -> LykRetainedRun {
    let available = Size(width: 200.0, height: 200.0)
    var tree = retainedTree()
    tree.measure(index: 0, available: available)
    tree.place(index: 0, origin: Point(x: 0.0, y: 0.0))

    let siblingBefore = tree.frame(2)
    let grandsiblingBefore = tree.frame(4)

    if changeLeaf {
        tree.nodes[3] = fixedLeaf(width: 40.0, height: 20.0)
        tree.propagateDirty([false, false, false, true, false])
    } else {
        tree.propagateDirty([false, false, false, false, false])
    }
    tree = tree.resetCounters()
    tree.measure(index: 0, available: available)
    tree.place(index: 0, origin: Point(x: 0.0, y: 0.0))

    return LykRetainedRun(
        measureComputes: tree.measureComputes,
        placeComputes: tree.placeComputes,
        measureSkips: tree.measureSkips,
        placeSkips: tree.placeSkips,
        changedWidth: tree.frame(3).width,
        siblingReused: framesEqual(tree.frame(2), siblingBefore) && framesEqual(
            tree.frame(4),
            grandsiblingBefore
        )
    )
}

construct LykUnchangedPassRecomputesNothing() extends Test {
    test {
        let run = retainedRun(changeLeaf: false)
        return run.measureComputes == 0 && run.placeComputes == 0
    }
    expect { return .Ok(true) }
}

construct LykUnchangedPassReusesEverySubtree() extends Test {
    test {
        let run = retainedRun(changeLeaf: false)
        return run.measureSkips > 0 && run.placeSkips > 0
    }
    expect { return .Ok(true) }
}

construct LykChangedLeafTakesItsNewSize() extends Test {
    test { return retainedRun(changeLeaf: true).changedWidth }
    expect { return .Ok(40.0) }
}

construct LykChangedLeafLeavesTheSiblingSubtreeWhereItWas() extends Test {
    test { return retainedRun(changeLeaf: true).siblingReused }
    expect { return .Ok(true) }
}

construct LykChangedLeafStillReusesTheUntouchedSubtrees() extends Test {
    test {
        let run = retainedRun(changeLeaf: true)
        return run.measureSkips > 0 && run.placeSkips > 0
    }
    expect { return .Ok(true) }
}

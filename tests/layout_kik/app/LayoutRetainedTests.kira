import Foundation
import KiraLayout

// Retained-layout cases: a pass over an unchanged tree recomputes nothing, and a
// pass after one changed leaf recomputes that leaf's ancestors while every other
// subtree keeps the geometry it already had.

struct LykRetainedRun {
    let measureComputes: Int
    let placeComputes: Int
    let measureSkips: Int
    let placeSkips: Int
    let changedWidth: Float
    let siblingReused: Bool
}

function lykRetainedRun(changeLeaf: Bool) -> LykRetainedRun {
    let engine = LayoutEngine()
    let available = Size(width: 200.0, height: 200.0)
    var tree = lykRetainedTree()
    engine.measure(tree: tree, index: 0, available: available)
    engine.place(tree: tree, index: 0, origin: Point(x: 0.0, y: 0.0))

    let siblingBefore = layoutFrame(tree, 2)
    let grandsiblingBefore = layoutFrame(tree, 4)

    if changeLeaf {
        tree.nodes[3] = lykFixedLeaf(width: 40.0, height: 20.0)
        layoutPropagateDirty(tree, [false, false, false, true, false])
    } else {
        layoutPropagateDirty(tree, [false, false, false, false, false])
    }
    tree = layoutResetCounters(move tree)
    engine.measure(tree: tree, index: 0, available: available)
    engine.place(tree: tree, index: 0, origin: Point(x: 0.0, y: 0.0))

    return LykRetainedRun(
        measureComputes: tree.measureComputes,
        placeComputes: tree.placeComputes,
        measureSkips: tree.measureSkips,
        placeSkips: tree.placeSkips,
        changedWidth: layoutFrame(tree, 3).width,
        siblingReused: lykFramesEqual(layoutFrame(tree, 2), siblingBefore) && lykFramesEqual(layoutFrame(tree, 4), grandsiblingBefore)
    )
}

Test LykUnchangedPassRecomputesNothing {
    test {
        let run = lykRetainedRun(changeLeaf: false)
        return run.measureComputes == 0 && run.placeComputes == 0
    }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

Test LykUnchangedPassReusesEverySubtree {
    test {
        let run = lykRetainedRun(changeLeaf: false)
        return run.measureSkips > 0 && run.placeSkips > 0
    }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

Test LykChangedLeafTakesItsNewSize {
    test { return lykRetainedRun(changeLeaf: true).changedWidth }
    expect { let e: Result<Float, TestFailure> = Result.Ok(40.0); return e }
}

Test LykChangedLeafLeavesTheSiblingSubtreeWhereItWas {
    test { return lykRetainedRun(changeLeaf: true).siblingReused }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

Test LykChangedLeafStillReusesTheUntouchedSubtrees {
    test {
        let run = lykRetainedRun(changeLeaf: true)
        return run.measureSkips > 0 && run.placeSkips > 0
    }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

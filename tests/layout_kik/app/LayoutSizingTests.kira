import Foundation
import KiraLayout

// Sizing cases: what a child that FILLS does to a parent that sizes from its
// CONTENT, and what it is resolved to afterwards.
//
// A filling child asks for whatever the parent turns out to be. Letting it also
// decide the parent's size makes the answer circular, and the parent comes out
// as large as whatever was offered to it — a row as tall as the window, with
// every sibling row pushed off the bottom.

construct LykHugRowKeepsTheHeightOfItsContent() extends Test {
    test { return (hugRow()).frame(0).height }
    expect { return .Ok(20.0) }
}

// Three fixed children in a row wide enough to hold them: each keeps the width
// it asked for, and each begins after the one before it ends. A child narrower
// than what it draws is a row drawn on top of itself.
construct LykFixedTrioKeepsEachChildAtItsWidth() extends Test {
    test { return (fixedTrio(400.0)).frame(2).width }
    expect { return .Ok(108.0) }
}

construct LykFixedTrioStartsEachChildAfterTheLast() extends Test {
    test {
        let tree = fixedTrio(400.0)
        return tree.frame(2).x - frameRight(tree, 1)
    }
    expect { return .Ok(8.0) }
}

// The same row in a column too narrow for it: the children give up the space
// between them, and the last one still ends inside the row rather than past it.
// Thirds of a width do not end exactly, so "inside" allows what rounding leaves
// past the edge, far less than a pixel.
construct LykFixedTrioKeepsTheTrailingChildInsideANarrowRow() extends Test {
    test {
        let tree = fixedTrio(300.0)
        return frameRight(tree, 3) - 300.0 < 0.000001
    }
    expect { return .Ok(true) }
}

// 300 offered, 60 + 40 spent on the fixed children: the spacer is the rest.
construct LykHugRowGivesTheLeftoverToTheFillChild() extends Test {
    test { return (hugRow()).frame(2).width }
    expect { return .Ok(200.0) }
}

construct LykHugRowKeepsTheTrailingChildInside() extends Test {
    test { return (hugRow()).frame(3).x }
    expect { return .Ok(260.0) }
}

// A filling child still fills the cross axis of the row it is in.
construct LykHugRowFillChildTakesTheRowHeight() extends Test {
    test { return (hugRow()).frame(2).height }
    expect { return .Ok(20.0) }
}

construct LykHugColumnKeepsTheWidthOfItsContent() extends Test {
    test { return (hugColumn()).frame(0).width }
    expect { return .Ok(60.0) }
}

// 800 offered, 20 + 24 spent: the spacer is the rest, and the trailing child
// therefore sits on the bottom edge.
construct LykHugColumnGivesTheLeftoverToTheFillChild() extends Test {
    test { return (hugColumn()).frame(2).height }
    expect { return .Ok(756.0) }
}

construct LykHugColumnPlacesTheTrailingChildLast() extends Test {
    test { return (hugColumn()).frame(3).y }
    expect { return .Ok(776.0) }
}

construct LykHugOverlayTakesTheSizeOfItsFixedChild() extends Test {
    test {
        let frame = (hugOverlay()).frame(0)
        return frame.width == 40.0 && frame.height == 20.0
    }
    expect { return .Ok(true) }
}

// The wash behind a row covers the row, and no more.
construct LykHugOverlayResolvesTheFillChildToTheContainer() extends Test {
    test {
        let laid = hugOverlay()
        return framesEqual(laid.frame(1), laid.frame(2))
    }
    expect { return .Ok(true) }
}

construct LykSplitPlacesTheFixedSidebar() extends Test {
    test {
        return framesEqual(
            (splitTree()).frame(1),
            Rect(x: 40.0, y: 40.0, width: 250.0, height: 640.0)
        )
    }
    expect { return .Ok(true) }
}

construct LykSplitGivesTheRestToTheFillingContent() extends Test {
    test {
        return framesEqual(
            (splitTree()).frame(2),
            Rect(x: 330.0, y: 40.0, width: 910.0, height: 640.0)
        )
    }
    expect { return .Ok(true) }
}

// --- Baseline rows -----------------------------------------------------------
//
// Children hang from one line. The deepest baseline in the row is where that
// line falls (18 here), and every other child is dropped by the difference — so
// a smaller run of text and a glyph beside a heading sit ON the heading's line
// rather than in the middle of the row.

construct LykBaselineRowLeavesTheDeepestChildAtTheTop() extends Test {
    test { return (baselineRow()).frame(1).y }
    expect { return .Ok(0.0) }
}

construct LykBaselineRowDropsTheSmallerRunOntoTheLine() extends Test {
    test { return (baselineRow()).frame(2).y }
    expect { return .Ok(6.0) }
}

construct LykBaselineRowDropsTheGlyphOntoTheLine() extends Test {
    test { return (baselineRow()).frame(3).y }
    expect { return .Ok(4.0) }
}

// The row is the line plus the longest drop below it — 18 + 6, not the tallest
// child. A FILLING child says nothing about where the line falls: it is as tall
// as whatever the row becomes, and letting it speak would drag the line to the
// row's bottom and take every word down with it.
construct LykBaselineRowIsTheLinePlusTheDeepestDrop() extends Test {
    test { return (baselineRow()).frame(0).height }
    expect { return .Ok(24.0) }
}

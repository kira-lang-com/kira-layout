import Foundation
import KiraLayout

// Sizing cases: what a child that FILLS does to a parent that sizes from its
// CONTENT, and what it is resolved to afterwards.
//
// A filling child asks for whatever the parent turns out to be. Letting it also
// decide the parent's size makes the answer circular, and the parent comes out
// as large as whatever was offered to it — a row as tall as the window, with
// every sibling row pushed off the bottom.

Test LykHugRowKeepsTheHeightOfItsContent {
    test { return layoutFrame(lykHugRow(), 0).height }
    expect { let e: Result<Float, TestFailure> = Result.Ok(20.0); return e }
}

// Three fixed children in a row wide enough to hold them: each keeps the width
// it asked for, and each begins after the one before it ends. A child narrower
// than what it draws is a row drawn on top of itself.
Test LykFixedTrioKeepsEachChildAtItsWidth {
    test { return layoutFrame(lykFixedTrio(400.0), 2).width }
    expect { let e: Result<Float, TestFailure> = Result.Ok(108.0); return e }
}

Test LykFixedTrioStartsEachChildAfterTheLast {
    test {
        let tree = lykFixedTrio(400.0)
        return layoutFrame(tree, 2).x - lykFrameRight(tree, 1)
    }
    expect { let e: Result<Float, TestFailure> = Result.Ok(8.0); return e }
}

// The same row in a column too narrow for it: the children give up the space
// between them, and the last one still ends inside the row rather than past it.
Test LykFixedTrioKeepsTheTrailingChildInsideANarrowRow {
    test {
        let tree = lykFixedTrio(300.0)
        return lykFrameRight(tree, 3) <= 300.0
    }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

// 300 offered, 60 + 40 spent on the fixed children: the spacer is the rest.
Test LykHugRowGivesTheLeftoverToTheFillChild {
    test { return layoutFrame(lykHugRow(), 2).width }
    expect { let e: Result<Float, TestFailure> = Result.Ok(200.0); return e }
}

Test LykHugRowKeepsTheTrailingChildInside {
    test { return layoutFrame(lykHugRow(), 3).x }
    expect { let e: Result<Float, TestFailure> = Result.Ok(260.0); return e }
}

// A filling child still fills the cross axis of the row it is in.
Test LykHugRowFillChildTakesTheRowHeight {
    test { return layoutFrame(lykHugRow(), 2).height }
    expect { let e: Result<Float, TestFailure> = Result.Ok(20.0); return e }
}

Test LykHugColumnKeepsTheWidthOfItsContent {
    test { return layoutFrame(lykHugColumn(), 0).width }
    expect { let e: Result<Float, TestFailure> = Result.Ok(60.0); return e }
}

// 800 offered, 20 + 24 spent: the spacer is the rest, and the trailing child
// therefore sits on the bottom edge.
Test LykHugColumnGivesTheLeftoverToTheFillChild {
    test { return layoutFrame(lykHugColumn(), 2).height }
    expect { let e: Result<Float, TestFailure> = Result.Ok(756.0); return e }
}

Test LykHugColumnPlacesTheTrailingChildLast {
    test { return layoutFrame(lykHugColumn(), 3).y }
    expect { let e: Result<Float, TestFailure> = Result.Ok(776.0); return e }
}

Test LykHugOverlayTakesTheSizeOfItsFixedChild {
    test {
        let frame = layoutFrame(lykHugOverlay(), 0)
        return frame.width == 40.0 && frame.height == 20.0
    }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

// The wash behind a row covers the row, and no more.
Test LykHugOverlayResolvesTheFillChildToTheContainer {
    test {
        let laid = lykHugOverlay()
        return lykFramesEqual(layoutFrame(laid, 1), layoutFrame(laid, 2))
    }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

Test LykSplitPlacesTheFixedSidebar {
    test {
        return lykFramesEqual(layoutFrame(lykSplit(), 1), Rect(x: 40.0, y: 40.0, width: 250.0, height: 640.0))
    }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

Test LykSplitGivesTheRestToTheFillingContent {
    test {
        return lykFramesEqual(layoutFrame(lykSplit(), 2), Rect(x: 330.0, y: 40.0, width: 910.0, height: 640.0))
    }
    expect { let e: Result<Bool, TestFailure> = Result.Ok(true); return e }
}

// --- Baseline rows -----------------------------------------------------------
//
// Children hang from one line. The deepest baseline in the row is where that
// line falls (18 here), and every other child is dropped by the difference — so
// a smaller run of text and a glyph beside a heading sit ON the heading's line
// rather than in the middle of the row.

Test LykBaselineRowLeavesTheDeepestChildAtTheTop {
    test { return layoutFrame(lykBaselineRow(), 1).y }
    expect { let e: Result<Float, TestFailure> = Result.Ok(0.0); return e }
}

Test LykBaselineRowDropsTheSmallerRunOntoTheLine {
    test { return layoutFrame(lykBaselineRow(), 2).y }
    expect { let e: Result<Float, TestFailure> = Result.Ok(6.0); return e }
}

Test LykBaselineRowDropsTheGlyphOntoTheLine {
    test { return layoutFrame(lykBaselineRow(), 3).y }
    expect { let e: Result<Float, TestFailure> = Result.Ok(4.0); return e }
}

// The row is the line plus the longest drop below it — 18 + 6, not the tallest
// child. A FILLING child says nothing about where the line falls: it is as tall
// as whatever the row becomes, and letting it speak would drag the line to the
// row's bottom and take every word down with it.
Test LykBaselineRowIsTheLinePlusTheDeepestDrop {
    test { return layoutFrame(lykBaselineRow(), 0).height }
    expect { let e: Result<Float, TestFailure> = Result.Ok(24.0); return e }
}

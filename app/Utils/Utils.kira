import Foundation

// Geometry the layout engine asks of Foundation's points, sizes and rectangles.

extend Point {
    // How far `other` is along the axes, summed: the taxicab distance.
    function manhattanDistance(other: borrow Point) -> Number {
        return abs(x - other.x) + abs(y - other.y)
    }

    function offset(dx: Number, dy: Number) -> Point {
        return Point(x: self.x + dx, y: self.y + dy)
    }
}

extend Size {
    function area() -> Number {
        return self.width * self.height
    }

    function scaled(factor: Number) -> Size {
        return Size(width: self.width * factor, height: self.height * factor)
    }
}

extend Rect {
    function center() -> Point {
        return Point(x: self.x + self.width / 2.0, y: self.y + self.height / 2.0)
    }

    function intersects(other: borrow Rect) -> Bool {
        return self.x < other.maxX() && self.maxX() > other.x && self.y < other.maxY() && self.maxY() > other.y
    }

    function inset(by: borrow EdgeInsets) -> Rect {
        let insetWidth = (self.width - by.leading) - by.trailing
        let insetHeight = (self.height - by.top) - by.bottom
        return Rect(
            x: self.x + by.leading,
            y: self.y + by.top,
            width: insetWidth,
            height: insetHeight
        )
    }
}

extend EdgeInsets {
    function horizontalTotal() -> Number {
        return self.leading + self.trailing
    }

    function verticalTotal() -> Number {
        return self.top + self.bottom
    }

    function total() -> Number {
        return self.horizontalTotal() + self.verticalTotal()
    }
}

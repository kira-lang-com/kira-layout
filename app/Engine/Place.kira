//! The placement pass: positions every node in a measured [`LayoutTree`] at its
//! origin, arranging its children inside the space its parent gives it.
//!
//! Placement runs after measurement. A node whose measured size and origin are unchanged
//! since its last placement is skipped, and a node that only moved is translated with its
//! subtree. Each arrangement (stack, absolute, grid, wrap, overlay, fill) lays out its
//! children in order. The layout rules are those of the layout model in `Model.kira`.
import Foundation
// Placement pass.
//
// Node and child fields are read directly through `result.nodes[i].field` /
// `tree.nodes[i].field`. Each such read borrow-elides to an aliased element read
// of a single scalar (see the IR field peephole) instead of cloning the whole
// ~40-field node into a `let` binding. Where a child snapshot must survive a
// mutating call (a re-measure or a recursive place that stores back into the same
// index), the needed scalars are hoisted into plain scalar locals *before* that
// call — preserving the old snapshot semantics without the per-node struct clone.

extend LayoutTree {
    /// Moves node `index` and every node under it by `dx` and `dy`, without measuring anything.
    function translateSubtree(borrow mut self, index: Number, dx: Number, dy: Number) {
        var result = self
        let childCount = result.nodes[index].childCount
        let firstChild = result.nodes[index].firstChild
        // In-place scalar shifts (no node clone, no array_set).
        result.nodes[index].originX = result.nodes[index].originX + dx
        result.nodes[index].originY = result.nodes[index].originY + dy
        result.nodes[index].placeOriginX = result.nodes[index].placeOriginX + dx
        result.nodes[index].placeOriginY = result.nodes[index].placeOriginY + dy
        for i in 0..childCount {
            result.translateSubtree(index: firstChild + i, dx: dx, dy: dy)
        }
    }

    /// Places node `index` at `origin`, arranging its children inside its padding.
    ///
    /// A node already placed at this origin with the same measured size is left as it is, and one that only moved is translated.
    function place(borrow mut self, index: Number, origin: borrow Point) {
        var result = self
        let subtreeDirty = result.nodes[index].subtreeDirty
        let placeCacheValid = result.nodes[index].placeCacheValid
        let measuredW = result.nodes[index].measuredW
        let measuredH = result.nodes[index].measuredH
        let placeMeasuredW = result.nodes[index].placeMeasuredW
        let placeMeasuredH = result.nodes[index].placeMeasuredH
        let placeOriginX = result.nodes[index].placeOriginX
        let placeOriginY = result.nodes[index].placeOriginY
        if !subtreeDirty && placeCacheValid && placeMeasuredW == measuredW && placeMeasuredH == measuredH {
            if placeOriginX == origin.x && placeOriginY == origin.y {
                result.placeSkips++
                return
            }
            result.translateSubtree(
                index: index,
                dx: origin.x - placeOriginX,
                dy: origin.y - placeOriginY
            )
            result.placeSkips++
            return
        }
        result.placeComputes++
        let padL = result.nodes[index].padL
        let padT = result.nodes[index].padT
        let padR = result.nodes[index].padR
        let padB = result.nodes[index].padB
        let arrange = result.nodes[index].arrange
        let innerOrigin = Point(x: origin.x + padL, y: origin.y + padT)
        let innerSize = Size(
            width: nonNegative(value: measuredW - (padL + padR)),
            height: nonNegative(value: measuredH - (padT + padB))
        )
        match arrange {
            Stack -> result.placeStack(index: index, origin: innerOrigin, available: innerSize)
            Absolute -> result.placeAbsolute(index: index, origin: innerOrigin)
            Grid -> result.placeGrid(index: index, origin: innerOrigin, available: innerSize)
            Wrap -> result.placeWrap(index: index, origin: innerOrigin, available: innerSize)
            Overlay -> result.placeOverlay(index: index, origin: innerOrigin, available: innerSize)
            Fill -> result.placeFill(index: index, origin: innerOrigin, available: innerSize)
        }
        // In-place placement write-back (mirrors measure). The place helpers above
        // only touch child indices, so the element at `index` still holds everything
        // except the origin/cache we overwrite here; the deferred origin write is safe
        // because children are positioned from `innerOrigin`.
        result.nodes[index].originX = origin.x
        result.nodes[index].originY = origin.y
        result.nodes[index].placeCacheValid = true
        result.nodes[index].placeOriginX = origin.x
        result.nodes[index].placeOriginY = origin.y
        result.nodes[index].placeMeasuredW = measuredW
        result.nodes[index].placeMeasuredH = measuredH
    }

    /// Returns how many children of the stack `index` fill its main axis.
    function stackFillCount(index: Number) -> Number {
        let horizontal = self.nodes[index].axis == .Horizontal
        let childCount = self.nodes[index].childCount
        let firstChild = self.nodes[index].firstChild
        var total = 0
        for i in 0..childCount {
            let childIndex = firstChild + i
            if horizontal {
                total = total + (self.nodes[childIndex].width.isFill() ? 1 : 0)
            } else {
                total = total + (self.nodes[childIndex].height.isFill() ? 1 : 0)
            }
        }
        return total
    }

    /// Returns the total flex weight of the children of the stack `index` that fill its main axis.
    ///
    /// A child with no flex counts as one.
    function stackFlexTotal(index: Number) -> Number {
        let horizontal = self.nodes[index].axis == .Horizontal
        let childCount = self.nodes[index].childCount
        let firstChild = self.nodes[index].firstChild
        var total = 0
        for i in 0..childCount {
            let childIndex = firstChild + i
            let wantsFill = horizontal ? self.nodes[childIndex].width.isFill() : self.nodes[childIndex].height.isFill()
            if wantsFill {
                let flex = self.nodes[childIndex].flex
                total = total + (flex > 0 ? flex : 1)
            }
        }
        return total
    }

    /// Returns the total outer size, along the stack's main axis, of its children that do not fill it.
    function stackFixedTotal(index: Number) -> Number {
        let horizontal = self.nodes[index].axis == .Horizontal
        let childCount = self.nodes[index].childCount
        let firstChild = self.nodes[index].firstChild
        var total = 0.0
        for i in 0..childCount {
            let childIndex = firstChild + i
            if horizontal {
                total = total + (
                    self.nodes[childIndex].width.isFill() ? 0.0 : self.nodes[childIndex].outerWidth()
                )
            } else {
                total = total + (
                    self.nodes[childIndex].height.isFill() ? 0.0 : self.nodes[childIndex].outerHeight()
                )
            }
        }
        return total
    }

    /// Records the size a child is placed at, and re-measures the child first when that size differs from its measured size.
    function remeasurePlacedChild(
        borrow mut self,
        childIndex: Number,
        width: Number,
        height: Number
    ) {
        var result = self
        let childMeasuredW = result.nodes[childIndex].measuredW
        let childMeasuredH = result.nodes[childIndex].measuredH
        let childChildCount = result.nodes[childIndex].childCount
        let resized = childMeasuredW != width || childMeasuredH != height
        if childChildCount > 0 && resized {
            result.measure(index: childIndex, available: Size(width: width, height: height))
        }
        // Store the placement-resolved size + resized flag directly in place. The
        // re-measure above repopulates the element's cache fields, which these scalar
        // writes leave untouched.
        result.nodes[childIndex].measuredW = width
        result.nodes[childIndex].measuredH = height
        result.nodes[childIndex].placeResized = resized
    }

    /// The deepest baseline among a row's children, which is the line the row writes
    /// on: every child is then dropped by the difference between that and its own.
    /// A child with no baseline of its own reports its bottom edge, so a glyph or a
    /// control beside a run of text hangs from the same line the letters sit on.
    function stackBaseline(index: Number) -> Number {
        let childCount = self.nodes[index].childCount
        let firstChild = self.nodes[index].firstChild
        var deepest = 0.0
        for i in 0..childCount {
            let child = firstChild + i
            let baseline = self.nodeBaseline(index: child)
            if baseline > deepest {
                deepest = baseline
            }
        }
        return deepest
    }

    /// What a child offers the row's baseline.
    ///
    /// A run of text offers the line its letters sit on. Anything else offers its
    /// bottom edge — a glyph, a field, a switch hangs from the line the way a word
    /// does. A child that FILLS the row offers nothing at all: it is as tall as
    /// whatever the row turns out to be, so letting it speak would drag the line to
    /// the row's own bottom and take every word down with it.
    function nodeBaseline(index: Number) -> Number {
        let baseline = self.nodes[index].baseline
        if baseline > 0.0 {
            return baseline
        }
        if self.nodes[index].height.isFill() {
            return 0.0
        }
        return self.nodes[index].outerHeight()
    }

    /// Returns how far a child is dropped so that its baseline sits on `rowBaseline`.
    ///
    /// A child with no baseline is not moved.
    function childBaselineOffset(childIndex: Number, rowBaseline: Number) -> Number {
        let baseline = self.nodeBaseline(index: childIndex)
        if baseline <= 0.0 {
            return 0.0
        }
        return nonNegative(value: rowBaseline - baseline)
    }

    /// Places the children of the stack `index` one after another along its main axis, aligned on the cross axis.
    ///
    /// With baseline alignment on a horizontal row, every child is measured before any is placed, so they share the deepest baseline.
    function placeStack(
        borrow mut self,
        index: Number,
        origin: borrow Point,
        available: borrow Size
    ) {
        var result = self
        let horizontal = result.nodes[index].axis == .Horizontal
        let alignment = result.nodes[index].alignment
        // A baseline row needs every child measured before any of them is placed:
        // the line they share is the deepest baseline among them.
        var rowBaseline = 0.0
        if alignment == .Baseline && horizontal {
            rowBaseline = result.stackBaseline(index: index)
        }
        let childCount = result.nodes[index].childCount
        let firstChild = result.nodes[index].firstChild
        let spacing = result.nodes[index].spacing
        let fillCount = result.stackFillCount(index: index)
        let flexTotal = result.stackFlexTotal(index: index)
        let fixedTotal = result.stackFixedTotal(index: index)
        let mainAvailable = horizontal ? available.width : available.height
        let remaining = nonNegative(
            value: mainAvailable - fixedTotal - repeatedSpacing(count: childCount, spacing: spacing)
        )
        let fillSize = flexTotal > 0 ? remaining / Number(flexTotal) : (
            fillCount > 0 ? remaining / Number(fillCount) : 0.0
        )
        var cursor = horizontal ? origin.x : origin.y
        for i in 0..childCount {
            let childIndex = firstChild + i
            // Snapshot the child scalars needed before the re-measure/place below
            // mutate this index.
            let childFlexRaw = result.nodes[childIndex].flex
            let flex = childFlexRaw > 0 ? childFlexRaw : 1
            let childWidthMode = result.nodes[childIndex].width
            let childHeightMode = result.nodes[childIndex].height
            let childMarL = result.nodes[childIndex].marL
            let childMarT = result.nodes[childIndex].marT
            let childMarB = result.nodes[childIndex].marB
            let childMarR = result.nodes[childIndex].marR
            var width = result.nodes[childIndex].measuredW
            var height = result.nodes[childIndex].measuredH
            if horizontal {
                width = childWidthMode.resolvedStackMainSize(
                    current: width,
                    fillSize: fillSize,
                    flex: flex
                )
                height = alignment.resolvedStackCrossSize(
                    cross: childHeightMode,
                    current: height,
                    available: available.height,
                    marginTotal: childMarT + childMarB
                )
                result.remeasurePlacedChild(childIndex: childIndex, width: width, height: height)
                var crossOffset = crossOffset(
                    childSize: result.nodes[childIndex].outerHeight(),
                    available: available.height,
                    alignment: alignment
                )
                if alignment == .Baseline {
                    crossOffset = result.childBaselineOffset(
                        childIndex: childIndex,
                        rowBaseline: rowBaseline
                    )
                }
                result.place(
                    index: childIndex,
                    origin: Point(x: cursor + childMarL, y: origin.y + crossOffset + childMarT)
                )
                cursor = cursor + result.nodes[childIndex].outerWidth() + spacing
            } else {
                height = childHeightMode.resolvedStackMainSize(
                    current: height,
                    fillSize: fillSize,
                    flex: flex
                )
                width = alignment.resolvedStackCrossSize(
                    cross: childWidthMode,
                    current: width,
                    available: available.width,
                    marginTotal: childMarL + childMarR
                )
                result.remeasurePlacedChild(childIndex: childIndex, width: width, height: height)
                let crossOffset = crossOffset(
                    childSize: result.nodes[childIndex].outerWidth(),
                    available: available.width,
                    alignment: alignment
                )
                result.place(
                    index: childIndex,
                    origin: Point(x: origin.x + crossOffset + childMarL, y: cursor + childMarT)
                )
                cursor = cursor + result.nodes[childIndex].outerHeight() + spacing
            }
        }
    }

    /// Places each child of the absolute container `index` at its own offset from `origin`.
    function placeAbsolute(borrow mut self, index: Number, origin: borrow Point) {
        var result = self
        let childCount = result.nodes[index].childCount
        let firstChild = result.nodes[index].firstChild
        for i in 0..childCount {
            let childIndex = firstChild + i
            let childDx = result.nodes[childIndex].dx
            let childDy = result.nodes[childIndex].dy
            let childMarL = result.nodes[childIndex].marL
            let childMarT = result.nodes[childIndex].marT
            result.place(
                index: childIndex,
                origin: Point(x: origin.x + childDx + childMarL, y: origin.y + childDy + childMarT)
            )
        }
    }

    /// Fill-arrange nodes (Surface, HitArea, Expanded, Spacer, TextureView) give each
    /// child the full available box, stacked in z-order like an Overlay/Frame. MUST
    /// loop over every child: placing only child 0 left later siblings unplaced at
    /// (0,0) — the "trailing content silently drops" bug, and an unplaced node's stale
    /// geometry crashes the render/hit pass at runtime.
    function placeFill(
        borrow mut self,
        index: Number,
        origin: borrow Point,
        available: borrow Size
    ) {
        var result = self
        let childCount = result.nodes[index].childCount
        let firstChild = result.nodes[index].firstChild
        for i in 0..childCount {
            let childIndex = firstChild + i
            let childMarL = result.nodes[childIndex].marL
            let childMarT = result.nodes[childIndex].marT
            let childMarR = result.nodes[childIndex].marR
            let childMarB = result.nodes[childIndex].marB
            let size = Size(
                width: nonNegative(value: available.width - (childMarL + childMarR)),
                height: nonNegative(value: available.height - (childMarT + childMarB))
            )
            result.remeasurePlacedChild(
                childIndex: childIndex,
                width: size.width,
                height: size.height
            )
            result.place(
                index: childIndex,
                origin: Point(x: origin.x + childMarL, y: origin.y + childMarT)
            )
        }
    }
}

/// The overlay sizing of a size mode.
extend SizeMode {
    /// An overlay child that fills is resolved against the container's OWN size here,
    /// the same way a stack resolves its cross axis. It contributed nothing to a
    /// content-sized container's measurement, so this is where it learns how large
    /// "fill" turned out to be.
    function overlayChildExtent(current: Number, available: Number, marginTotal: Number) -> Number {
        if self.isFill() {
            return nonNegative(value: available - marginTotal)
        }
        return current
    }
}

extend LayoutTree {
    /// Places every child of the overlay `index` over the same box, each aligned by the overlay's alignment.
    function placeOverlay(
        borrow mut self,
        index: Number,
        origin: borrow Point,
        available: borrow Size
    ) {
        var result = self
        let childCount = result.nodes[index].childCount
        let firstChild = result.nodes[index].firstChild
        let overlayAlignment = result.nodes[index].overlayAlignment
        for i in 0..childCount {
            let childIndex = firstChild + i
            let childMarL = result.nodes[childIndex].marL
            let childMarT = result.nodes[childIndex].marT
            let childMarR = result.nodes[childIndex].marR
            let childMarB = result.nodes[childIndex].marB
            let childWidth = result.nodes[childIndex].width.overlayChildExtent(
                current: result.nodes[childIndex].measuredW,
                available: available.width,
                marginTotal: childMarL + childMarR
            )
            let childHeight = result.nodes[childIndex].height.overlayChildExtent(
                current: result.nodes[childIndex].measuredH,
                available: available.height,
                marginTotal: childMarT + childMarB
            )
            result.remeasurePlacedChild(
                childIndex: childIndex,
                width: childWidth,
                height: childHeight
            )
            let outer = Size(
                width: result.nodes[childIndex].outerWidth(),
                height: result.nodes[childIndex].outerHeight()
            )
            let outerOrigin = alignedOrigin(
                child: outer,
                container: available,
                origin: origin,
                alignment: overlayAlignment
            )
            result.place(
                index: childIndex,
                origin: Point(x: outerOrigin.x + childMarL, y: outerOrigin.y + childMarT)
            )
        }
    }

    /// Places the children of the grid `index` in rows of its column count.
    ///
    /// Columns share the available width, less the spacing between them. A row is as tall as its tallest child.
    function placeGrid(
        borrow mut self,
        index: Number,
        origin: borrow Point,
        available: borrow Size
    ) {
        var result = self
        let columns = result.nodes[index].columns
        if columns <= 0 {
            return
        }
        let childCount = result.nodes[index].childCount
        let firstChild = result.nodes[index].firstChild
        let spacing = result.nodes[index].spacing
        let rowSpacing = result.nodes[index].rowSpacing
        let cellWidth = (
            available.width - repeatedSpacing(count: columns, spacing: spacing)
        ) / Number(columns)
        var rowY = origin.y
        var rowHeight = 0.0
        for i in 0..childCount {
            let column = i % columns
            if column == 0 && i > 0 {
                rowY = rowY + rowHeight + rowSpacing
                rowHeight = 0.0
            }
            let childIndex = firstChild + i
            let childWidthMode = result.nodes[childIndex].width
            let childMarL = result.nodes[childIndex].marL
            let childMarT = result.nodes[childIndex].marT
            let childMarR = result.nodes[childIndex].marR
            let childMeasuredH = result.nodes[childIndex].measuredH
            let width = childWidthMode.isFill() ? nonNegative(
                value : cellWidth - (childMarL + childMarR)
            ): result.nodes[childIndex].measuredW
            result.remeasurePlacedChild(
                childIndex: childIndex,
                width: width,
                height: childMeasuredH
            )
            result.place(
                index: childIndex,
                origin: Point(
                    x: origin.x + Number(column) * (cellWidth + spacing) + childMarL,
                    y: rowY + childMarT
                )
            )
            rowHeight = rowHeight > result.nodes[childIndex].outerHeight() ? rowHeight : result.nodes[childIndex].outerHeight()
        }
    }

    /// Places the children of the wrap `index` in rows that break before a child that would pass the available width.
    function placeWrap(
        borrow mut self,
        index: Number,
        origin: borrow Point,
        available: borrow Size
    ) {
        var result = self
        let childCount = result.nodes[index].childCount
        let firstChild = result.nodes[index].firstChild
        let spacing = result.nodes[index].spacing
        let rowSpacing = result.nodes[index].rowSpacing
        let alignment = result.nodes[index].alignment
        var cursorX = origin.x
        var cursorY = origin.y
        var rowHeight = 0.0
        for i in 0..childCount {
            let childIndex = firstChild + i
            let childMarL = result.nodes[childIndex].marL
            let childMarT = result.nodes[childIndex].marT
            let childWidth = result.nodes[childIndex].outerWidth()
            let childHeight = result.nodes[childIndex].outerHeight()
            if cursorX > origin.x && cursorX + childWidth > origin.x + available.width {
                cursorX = origin.x
                cursorY = cursorY + rowHeight + rowSpacing
                rowHeight = 0.0
            }
            let crossOffset = crossOffset(
                childSize: childHeight,
                available: rowHeight > childHeight ? rowHeight : childHeight,
                alignment: alignment
            )
            result.place(
                index: childIndex,
                origin: Point(x: cursorX + childMarL, y: cursorY + crossOffset + childMarT)
            )
            cursorX = cursorX + childWidth + spacing
            rowHeight = rowHeight > childHeight ? rowHeight : childHeight
        }
    }
}

import Foundation
function layoutEngineResolveSizeMode(kind: Int, value: Float, available: Float, content: Float) -> Float {
    if kind == 1 {
        return nonNegative(value: value)
    }
    if kind == 2 {
        return nonNegative(value: available)
    }
    if kind == 3 {
        return nonNegative(value: content)
    }
    if kind == 4 {
        return nonNegative(value: available * value)
    }
    if kind == 5 {
        return content > value ? content : value
    }
    return content < value ? content : value
}

function layoutEngineResolveOuterSize(kind: Int, value: Float, available: Float, content: Float, padding: Float) -> Float {
    if kind == 1 {
        return nonNegative(value: value)
    }
    if kind == 2 {
        return nonNegative(value: available)
    }
    if kind == 3 {
        return nonNegative(value: content + padding)
    }
    if kind == 4 {
        return nonNegative(value: available * value)
    }
    if kind == 5 {
        return content + padding > value ? content + padding : value
    }
    return content + padding < value ? content + padding : value
}

function layoutEngineSizeModeIsFill(kind: Int) -> Bool {
    return kind == 2
}

// Whether a size mode resolves from the node's content: Hug, and the two
// content-versus-value modes (at least / at most).
function layoutEngineSizeModeUsesContent(kind: Int) -> Bool {
    return kind == 3 || kind == 5 || kind == 6
}

// What a child contributes to a content-sized parent on one axis.
//
// A child that fills contributes NOTHING to a parent that sizes from its
// content: "fill the parent" cannot also mean "make the parent bigger", and
// resolving it as the offered size makes a hugging parent as large as whatever
// was offered to it. The child is resolved against the parent's final size in
// the placement pass instead — the main axis from the leftover space, the cross
// axis from the container — so it still fills exactly what it was asked to.
function layoutEngineContentExtent(childOuter: Float, childKind: Int, parentUsesContent: Bool) -> Float {
    if parentUsesContent && layoutEngineSizeModeIsFill(kind: childKind) {
        return 0.0
    }
    return childOuter
}

function layoutEngineComputeCrossOffset(childSize: Float, available: Float, alignmentCode: Int) -> Float {
    if alignmentCode == 1 {
        return 0.0
    }
    if alignmentCode == 2 {
        return (available - childSize) / 2.0
    }
    if alignmentCode == 3 {
        return available - childSize
    }
    return 0.0
}

function layoutEngineResolvedStackMainSize(kind: Int, current: Float, fillSize: Float, flex: Int) -> Float {
    if kind == 2 {
        return fillSize * intAsFloat(value: flex)
    }
    return current
}

// Cross-axis size of a stack child. Stretch (alignmentCode 4) sizes every child
// to the container. A Fill cross child (crossKind 2) also fills the container's
// resolved cross extent regardless of alignment: "Fill" means fill, and
// Start/Center/End cannot position something that already occupies the full
// cross axis. Without this, `VStackFill{...}.width(W)` (Start cross) left its
// Fill rows at the width they measured against the grandparent — overflowing W,
// which pushed trailing content (after a Spacer) past the clip and dropped it.
function layoutEngineResolvedStackCrossSize(alignmentCode: Int, crossKind: Int, current: Float, available: Float, marginTotal: Float) -> Float {
    if alignmentCode == 4 || crossKind == 2 {
        return nonNegative(value: available - marginTotal)
    }
    return current
}

function layoutEngineAlignedOrigin(child: borrow Size, container: borrow Size, origin: borrow Point, alignmentCode: Int) -> Point {
    var dx = 0.0
    var dy = 0.0
    if alignmentCode == 2 {
        dx = (container.width - child.width) / 2.0
    } else if alignmentCode == 3 {
        dx = container.width - child.width
    } else if alignmentCode == 5 {
        dx = (container.width - child.width) / 2.0
        dy = (container.height - child.height) / 2.0
    } else if alignmentCode == 6 {
        dx = container.width - child.width
        dy = (container.height - child.height) / 2.0
    } else if alignmentCode == 7 {
        dy = container.height - child.height
    } else if alignmentCode == 8 {
        dx = (container.width - child.width) / 2.0
        dy = container.height - child.height
    } else if alignmentCode == 9 {
        dx = container.width - child.width
        dy = container.height - child.height
    } else if alignmentCode == 4 {
        dy = (container.height - child.height) / 2.0
    }
    return Point(x: origin.x + dx, y: origin.y + dy)
}
import Foundation

public function nonNegative(value: Number) -> Number {
    return value > 0.0 ? value : 0.0
}

public function repeatedSpacing(count: Number, spacing: Number) -> Number {
    if count <= 1 {
        return 0.0
    }
    return Number(count - 1) * spacing
}

extend LayoutNode {
    function outerWidth() -> Number {
        return self.measuredW + self.marL + self.marR
    }

    function outerHeight() -> Number {
        return self.measuredH + self.marT + self.marB
    }

    // Absolute-arrange extent helpers: the child's outer size plus its descriptor
    // offset. Kept as `borrow LayoutNode` functions so callers can pass
    // `tree.nodes[i]` directly and let the VM borrow-elide the array read instead of
    // cloning the whole 40-field node just to sum a few scalars.
    function outerRight() -> Number {
        return self.dx + self.measuredW + self.marL + self.marR
    }

    function outerBottom() -> Number {
        return self.dy + self.measuredH + self.marT + self.marB
    }
}

public function constrainedChildAxisOffer(
    parentAvailable: Number,
    mode: borrow SizeMode
) -> Number {
    match mode {
        Fixed(value) -> return nonNegative(value: value)
        Fill -> return nonNegative(value: parentAvailable)
        Fraction(of) -> return nonNegative(value: parentAvailable * of)
        Min(value) -> return parentAvailable > value ? parentAvailable : value
        Max(value) -> return parentAvailable < value ? parentAvailable : value
        Hug -> return parentAvailable
        Reveal(fraction) -> return parentAvailable
    }
}

public function childAvailableSize(
    parentAvailable: borrow Size,
    parent: borrow LayoutNode,
    child: borrow LayoutNode,
    childCount: Number
) -> Size {
    var width = parentAvailable.width
    var height = parentAvailable.height

    if parent.arrange == .Stack {
        let totalSpacing = repeatedSpacing(count: childCount, spacing: parent.spacing)
        if parent.axis == .Horizontal {
            width = width - totalSpacing
        } else {
            height = height - totalSpacing
        }
    }

    if parent.arrange == .Grid {
        if parent.columns > 0 {
            let totalSpacing = repeatedSpacing(count: parent.columns, spacing: parent.spacing)
            width = (width - totalSpacing) / Number(parent.columns)
        }
    } else if parent.arrange == .Overlay {
        width = constrainedChildAxisOffer(parentAvailable.width, parent.width)
        height = constrainedChildAxisOffer(parentAvailable.height, parent.height)
    }

    return Size(
        width: nonNegative(value: width - (child.marL + child.marR)),
        height: nonNegative(value: height - (child.marT + child.marB))
    )
}
